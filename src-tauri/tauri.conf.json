{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Kerros",
  "version": "../package.json",
  "identifier": "fi.iki.dr.kerros",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5180",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Kerros",
        "width": 1440,
        "height": 900,
        "resizable": true,
        "fullscreen": false,
        "minWidth": 1100,
        "minHeight": 700
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    },
    "category": "GraphicsDesign",
    "copyright": "Daniel Rautio",
    "shortDescription": "Design lamps as stacks of laser-cut slices",
    "longDescription": "Kerros builds a form as a signed distance field, hollows and carves it, slices it along Z into sheets of real material, nests the parts onto the laser bed and exports DXF ready to cut."
  }
}
